generator client {
  provider = "prisma-client-js"
}

enum FuelAmountType {
  LITER
  COUPON
  CASH
}

enum FuelStatus {
  FUELED
  NOT_FUELED
  HALF_FUELED
}

model FuelRequest {
  id          String @id @default(uuid()) @db.Uuid
  requestorId String @db.Uuid
  vehicleId   String @db.Uuid

  date                 DateTime
  odometer             Int
  amount               Float
  amountType           FuelAmountType
  notes                String?
  status               FuelStatus     @default(NOT_FUELED)
  returnOdometerKm     Int?
  remainingFuelRequest Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // vehicle Vehicle @relation(fields: [vehicleId], references: [id])
  user    User    @relation(fields: [requestorId], references: [id])
}

// ====================================================================
// WORKFLOW: OVERTIME REQUEST MODEL
// ====================================================================

model OvertimeRequest {
  id           String                @id @default(uuid()) @db.Uuid
  reqId        String                @db.Uuid
  departmentId String?               @db.Uuid
  overtimeType OvertimeType
  durationType OvertimeDurationType
  startTime    DateTime?
  endTime      DateTime?
  dates        DateTime[]
  description  String?
  status       RequestDecisionStatus @default(PENDING)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  // Relations
  requestor                User?                      @relation(fields: [reqId], references: [id])
  department               Department?                @relation(fields: [departmentId], references: [id])
  notifications            OvertimeNotification[]
  // Vehicle                  Vehicle?                   @relation(fields: [vehicleId], references: [id])
  // vehicleId                String?                    @db.Uuid
  // HrOvertimeNotification   HrOvertimeNotification[]
  // UserOvertimeNotification UserOvertimeNotification[]

  @@index([reqId])
  @@index([departmentId])
}

// ====================================================================
// WORKFLOW: OVERTIME NOTIFICATION MODEL
// ====================================================================

model OvertimeNotification {
  id                String   @id @default(uuid()) @db.Uuid
  message           String
  userId            String   @db.Uuid
  overtimeRequestId String   @db.Uuid
  departmentId      String?  @db.Uuid
  createdAt         DateTime @default(now())

  // Relations
  user            User            @relation(fields: [userId], references: [id])
  overtimeRequest OvertimeRequest @relation(fields: [overtimeRequestId], references: [id])
  department      Department?     @relation(fields: [departmentId], references: [id])
  // Vehicle         Vehicle?        @relation(fields: [vehicleId], references: [id])
  // vehicleId       String?         @db.Uuid

  @@index([userId])
  @@index([overtimeRequestId])
  @@index([departmentId])
}

