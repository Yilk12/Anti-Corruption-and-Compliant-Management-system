{
  "name": "ethiopian-helpdesk-backend",
  "version": "1.0.0",
  "description": "Backend API for Ethiopian Civil Service Commission Helpdesk and Knowledge Base",
  "main": "dist/main.js",
  "scripts": {
    "build": "npm install --legacy-peer-deps && node --max-old-space-size=4096 ./node_modules/@nestjs/cli/bin/nest build && node scripts/copy-i18n.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "npx nest start",
    "start:dev": "ts-node src/main.ts",
    "start:debug": "npx nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "prisma:seed": "prisma db seed",
    "prisma:status": "prisma migrate status",
    "prisma:migrate:reset": "prisma migrate reset --force",
    "prisma:deploy": "prisma migrate deploy",
    "seed:users": "ts-node src/scripts/seed-users.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@nestjs/cache-manager": "^12.0.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.4.2",
    "@nestjs/jwt": "^10.1.1",
    "@nestjs/passport": "^10.0.2",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/swagger": "^12.1.1",
    "@prisma/client": "^5.22.0",
    "accept-language-parser": "^1.5.0",
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "cache-manager": "^7.2.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "docx": "^9.7.1",
    "exceljs": "^3.4.0",
    "fontkit": "^2.0.4",
    "helmet": "^8.1.0",
    "i18next": "^25.5.2",
    "i18next-fs-backend": "^2.6.0",
    "multer": "^2.5.0",
    "multer-storage-cloudinary": "^2.2.1",
    "nestjs-i18n": "^10.3.0",
    "nodemailer": "^10.5.0",
    "passport": "^0.6.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "socket.io-client": "^4.8.1",
    "uuid": "^14.0.3",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.4.2",
    "@types/bcryptjs": "^2.4.4",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^4.17.17",
    "@types/helmet": "^0.0.48",
    "@types/jest": "^29.5.2",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.3.1",
    "@types/nodemailer": "^6.4.13",
    "@types/passport-jwt": "^3.0.9",
    "@types/passport-local": "^1.0.35",
    "@types/pdfkit": "^0.17.6",
    "@types/uuid": "^9.0.6",
    "@types/winston": "^2.4.4",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "prisma": "^5.22.0",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.1.2",
    "typescript": "^5.1.3"
  },
  "prisma": {
    "seed": "ts-node src/scripts/seed-users.ts"
  }
}
